# Which Solana network the app talks to: localnet | devnet
VITE_CLUSTER=devnet
# Recommended: a dedicated devnet RPC URL (e.g. Helius). Defaults to the public devnet RPC,
# which is heavily rate-limited. On Netlify, set this as a (non-secret) environment variable.
# VITE_RPC_URL=https://devnet.helius-rpc.com/?api-key=...
# Required: the Privy App ID for Google login (Privy dashboard > App settings > API keys).
VITE_PRIVY_APP_ID=
